# Secrets (Spec §2): API keys live here, never in git.
.env
.env.*
!.env.example

# Godot
.godot/
.import/
*.translation
export_presets.cfg.bak
/builds/

# Movie Maker captures and other local renders
/captures/

# Blender
*.blend1
*.blend2

# Python
__pycache__/
*.pyc
.venv/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Agent worktrees (parallel module builds)
.worktrees/

# Usage watcher's emergency snapshot (untracked by design)
HANDOFF-SNAPSHOT.md

# Rejected raw outputs and intermediates of the art pipeline (M4)
assets/source/_cache/

# Per-run pipeline stills and dump copies (only the A/B and pose sheets are committed)
assets/source/characters/*/report*/stills/*_front.png
assets/source/characters/*/report*/stills/*_side.png
assets/source/characters/*/report*/stills/*_three_quarter.png
assets/source/characters/*/report*/stills/*_sheet.png
assets/source/characters/*/report*/bones.json
