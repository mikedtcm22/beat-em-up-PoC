[sub_resource type="Resource" id="Resource_punk"]
script = ExtResource("2_entry")
key = &"punk"
label = "STREET PUNK"
textures = Array[Texture2D]([ExtResource("4_punk")])

[sub_resource type="Resource" id="Resource_thug"]
