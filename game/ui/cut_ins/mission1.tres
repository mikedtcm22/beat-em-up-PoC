[sub_resource type="Resource" id="Resource_end"]
script = ExtResource("2_entry")
key = &"mission_end"
label = "MISSION CLEAR!"
textures = Array[Texture2D]([ExtResource("7_end")])

[resource]
script = ExtResource("1_set")
title = SubResource("Resource_title")
entrances = Array[ExtResource("2_entry")]([SubResource("Resource_punk"), SubResource("Resource_thug"), SubResource("Resource_bruiser"), SubResource("Resource_kicker"), SubResource("Resource_ox")])
ko_panels = Array[ExtResource("2_entry")]([SubResource("Resource_ko_punk")])
mission_end = SubResource("Resource_end")
end_prompt = "PRESS A BUTTON"
