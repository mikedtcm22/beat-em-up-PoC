# Copy to .env (git-ignored) and fill in the keys. Variable names follow each service SDK's
# standard naming. See README.md, "API keys".

# Image generation (concept art): Google Gemini (Game-boy's choice, 2026-10-26)
GEMINI_API_KEY=

# 3D generation: Tripo (Game-boy's choice, 2026-10-26)
TRIPO_API_KEY=

# Sound effects: ElevenLabs, Starter plan (Game-boy's choice, 2026-11-04: the voices of Milestone 6).
# Game-boy's .env names it ELEVEN_LABS_API_KEY; the audio tools read that or the SDK's ELEVENLABS_API_KEY.
ELEVEN_LABS_API_KEY=
