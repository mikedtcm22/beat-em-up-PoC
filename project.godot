; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Beat-em-Up PoC"
config/description="First-person beat-em-up proof of concept."
run/main_scene="res://game/level/mission1/mission1.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Tuning="*res://game/autoload/tuning.gd"
CombatEvents="*res://game/autoload/combat_events.gd"
TimeController="*res://game/autoload/time_controller.gd"
GameInput="*res://game/autoload/game_input.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/exclude_addons=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player_body"
3d_physics/layer_3="enemy_body"
3d_physics/layer_4="hurtbox"
3d_physics/layer_5="pickup"
3d_physics/layer_6="downed_body"
3d_physics/layer_7="projectile"
3d_physics/layer_8="ragdoll"
3d_physics/layer_9="edge_guard"
3d_render/layer_1="default"
3d_render/layer_2="fp_hidden"
3d_render/layer_3="debug"

[navigation]

3d/default_cell_height=0.1
avoidance/thread_model/avoidance_use_multiple_threads=false
world/map_use_async_iterations=false
world/region_use_async_iterations=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[shader_globals]

paint_trim_grain={
"type": "vec2",
"value": Vector2(0, 90)
}
paint_key_dir={
"type": "vec3",
"value": Vector3(0.4, 0.8, 0.45)
}

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
