class_name VideoWorldSprites
extends RefCounted
## The particle sprites of the world look, made by code (PLAN.md section 4 part 4: "every sprite generated by code"): a hard
## two-tone ember, a painted steam puff of two or three flat values with an uneven edge, a dust mote. No file is read or written.
## Each is white-ish paint over alpha, so the particle's colour tints it; they are deterministic (hashed, never random).

const EMBER_PX := 32
const PUFF_PX := 96
const MOTE_PX := 24


static func _hash(x: int, y: int, seed_value: int) -> float:
	var h := (x * 73856093) ^ (y * 19349663) ^ (seed_value * 83492791)
	h = (h ^ (h >> 13)) * 1274126177
	return float((h ^ (h >> 16)) & 0xFFFF) / 65535.0


static func _vnoise(x: float, y: float, seed_value: int) -> float:
	var ix := floori(x)
	var iy := floori(y)
	var fx := x - ix
	var fy := y - iy
	fx = fx * fx * (3.0 - 2.0 * fx)
	fy = fy * fy * (3.0 - 2.0 * fy)
	var a := lerpf(_hash(ix, iy, seed_value), _hash(ix + 1, iy, seed_value), fx)
	var b := lerpf(_hash(ix, iy + 1, seed_value), _hash(ix + 1, iy + 1, seed_value), fx)
	return lerpf(a, b, fy)


## A small hard diamond: a white-hot core inside an orange-ish rim (the colour comes from the particle), two flat values.
static func ember() -> ImageTexture:
	var image := Image.create(EMBER_PX, EMBER_PX, false, Image.FORMAT_RGBA8)
	var c := (EMBER_PX - 1) * 0.5
	for y in EMBER_PX:
		for x in EMBER_PX:
			var d := (absf(x - c) + absf(y - c)) / c
			var v := 0.0
			if d < 0.95:
				v = 0.55
			if d < 0.5:
				v = 1.0
			image.set_pixel(x, y, Color(v, v, v, 1.0 if d < 0.95 else 0.0))
	return ImageTexture.create_from_image(image)


## A painted puff: an uneven blob of noise-thresholded circles in two flat values (a lit top, a shaded underside), hard edge.
static func puff(seed_value: int = 3) -> ImageTexture:
	var image := Image.create(PUFF_PX, PUFF_PX, false, Image.FORMAT_RGBA8)
	var c := (PUFF_PX - 1) * 0.5
	for y in PUFF_PX:
		for x in PUFF_PX:
			var dx := (x - c) / c
			var dy := (y - c) / c
			var r := sqrt(dx * dx + dy * dy)
			var n := _vnoise(x * 0.09, y * 0.09, seed_value) * 0.6 + _vnoise(x * 0.21, y * 0.21, seed_value + 5) * 0.4
			var shape := r + (n - 0.5) * 0.9
			var a := 0.0
			var v := 0.0
			if shape < 0.62:
				a = 1.0
				v = 0.55
				# The lit side: up and to the left, a second flat value with its own uneven edge.
				var lit := -dy * 0.7 - dx * 0.4 + (n - 0.5) * 0.8
				if lit > 0.1:
					v = 0.95
			image.set_pixel(x, y, Color(v, v, v, a))
	return ImageTexture.create_from_image(image)


## A dust mote: a flat disc, two values.
static func mote() -> ImageTexture:
	var image := Image.create(MOTE_PX, MOTE_PX, false, Image.FORMAT_RGBA8)
	var c := (MOTE_PX - 1) * 0.5
	for y in MOTE_PX:
		for x in MOTE_PX:
			var r := sqrt((x - c) * (x - c) + (y - c) * (y - c)) / c
			var a := 1.0 if r < 0.9 else 0.0
			var v := 1.0 if r < 0.45 else 0.7
			image.set_pixel(x, y, Color(v, v, v, a))
	return ImageTexture.create_from_image(image)


# ---- Round 3 (LD-WORLD3): painted sprites with drawn, anti-aliased edges, in flipbooks of varied shapes ----
## The atlases' frames (side by side) and one frame's size in pixels.
const ATLAS_FRAMES := 4
const EMBER_ATLAS_PX := 64
const PUFF_ATLAS_PX := 192


## The alpha of a signed distance `d` (negative inside), edge `aa` wide: a crisp edge with no stair-step.
static func _cover(d: float, aa: float) -> float:
	return 1.0 - smoothstep(-aa, aa, d)


## An ember's signed distance for shape `kind` at p in [-1, 1]: a diamond, a round bit, a slanted shard and a four-point spark.
static func _ember_sdf(kind: int, p: Vector2) -> float:
	match kind:
		0:
			return (absf(p.x) + absf(p.y) - 0.78) * 0.7071
		1:
			return p.length() - 0.62
		2:
			var rot := p.rotated(0.6)
			return (Vector2(rot.x / 0.3, rot.y / 0.92).length() - 1.0) * 0.3
		_:
			return (pow(absf(p.x), 0.55) + pow(absf(p.y), 0.55) - 0.95) * 0.34
	return 1.0


## Four ember shapes side by side (EMBER_ATLAS_PX each): a white-hot core in a dimmer rim, edges anti-aliased. Use `particles_anim_h_frames = ATLAS_FRAMES`.
static func ember_atlas() -> ImageTexture:
	var size := EMBER_ATLAS_PX
	var image := Image.create(size * ATLAS_FRAMES, size, true, Image.FORMAT_RGBA8)
	var aa := 2.2 / float(size)
	for k in ATLAS_FRAMES:
		for y in size:
			for x in size:
				var p := Vector2((x + 0.5) / size * 2.0 - 1.0, (y + 0.5) / size * 2.0 - 1.0)
				var d := _ember_sdf(k, p)
				var a := _cover(d, aa)
				var hot := _cover(d + 0.2, aa)
				var v := 0.5 + 0.5 * hot
				image.set_pixel(k * size + x, y, Color(v, v, v, a))
	image.generate_mipmaps()
	return ImageTexture.create_from_image(image)


## The circles of steam frame `k`: one billowing cluster of four or five big overlapping lobes with a couple of small ones standing off it, as
## (centre x, centre y, radius) in [-1, 1] (y down). A plume is many such clusters, never a string of beads.
static func _puff_circles(k: int) -> Array[Vector3]:
	var out: Array[Vector3] = []
	var count := 4 + int(_hash(k, 2, 7) * 2.0)
	for i in count:
		var a := TAU * (float(i) / float(count) + _hash(k, i + 10, 7) * 0.15)
		var spread := 0.12 + 0.2 * _hash(k, i + 30, 7)
		var r := 0.34 + 0.18 * _hash(k, i + 50, 7)
		out.append(Vector3(cos(a) * spread, sin(a) * spread * 0.8 + 0.05, r))
	for j in 2:
		var side := -1.0 if (j + k) % 2 == 0 else 1.0
		out.append(Vector3(side * (0.45 + 0.15 * _hash(k, j + 70, 7)), -0.25 + 0.5 * _hash(k, j + 80, 7), 0.13 + 0.07 * _hash(k, j + 90, 7)))
	return out


static func _circles_sdf(circles: Array[Vector3], p: Vector2, shift: Vector2, shrink: float) -> float:
	var d := 1.0e9
	for c in circles:
		d = minf(d, p.distance_to(Vector2(c.x, c.y) + shift) - (c.z - shrink))
	return d


## Four painted steam puffs side by side (PUFF_ATLAS_PX each): a hard silhouette of lobes, two flat values (a lit side and a shaded side) and a
## darker line along the edge; anti-aliased, never a soft cotton ball. White-ish over alpha, so the particle's colour tints it.
static func puff_atlas() -> ImageTexture:
	var size := PUFF_ATLAS_PX
	var image := Image.create(size * ATLAS_FRAMES, size, true, Image.FORMAT_RGBA8)
	var aa := 1.6 / float(size) * 2.0
	for k in ATLAS_FRAMES:
		var circles := _puff_circles(k)
		for y in size:
			for x in size:
				var p := Vector2((x + 0.5) / size * 2.0 - 1.0, (y + 0.5) / size * 2.0 - 1.0)
				var d := _circles_sdf(circles, p, Vector2.ZERO, 0.0)
				if d > 0.05:
					image.set_pixel(k * size + x, y, Color(0.0, 0.0, 0.0, 0.0))
					continue
				var a := _cover(d, aa)
				var lit := _cover(_circles_sdf(circles, p, Vector2(0.07, 0.09), 0.09), aa)
				var v := lerpf(0.58, 0.98, lit)
				var rim := smoothstep(-0.05 - aa, -0.05 + aa, d)
				v = lerpf(v, v * 0.55, rim)
				image.set_pixel(k * size + x, y, Color(v, v, v, a))
	image.generate_mipmaps()
	return ImageTexture.create_from_image(image)
