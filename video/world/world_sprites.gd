class_name VideoWorldSprites
extends RefCounted
## The particle sprites of the world look, made by code (PLAN.md section 4 part 4: "every sprite generated by code"): a hard
## two-tone ember, a painted steam puff of two or three flat values with an uneven edge, a dust mote. No file is read or written.
## Each is white-ish paint over alpha, so the particle's colour tints it; they are deterministic (hashed, never random).

const EMBER_PX := 32
const PUFF_PX := 96
const MOTE_PX := 24


static func _hash(x: int, y: int, seed_value: int) -> float:
	var h := (x * 73856093) ^ (y * 19349663) ^ (seed_value * 83492791)
	h = (h ^ (h >> 13)) * 1274126177
	return float((h ^ (h >> 16)) & 0xFFFF) / 65535.0


static func _vnoise(x: float, y: float, seed_value: int) -> float:
	var ix := floori(x)
	var iy := floori(y)
	var fx := x - ix
	var fy := y - iy
	fx = fx * fx * (3.0 - 2.0 * fx)
	fy = fy * fy * (3.0 - 2.0 * fy)
	var a := lerpf(_hash(ix, iy, seed_value), _hash(ix + 1, iy, seed_value), fx)
	var b := lerpf(_hash(ix, iy + 1, seed_value), _hash(ix + 1, iy + 1, seed_value), fx)
	return lerpf(a, b, fy)


## A small hard diamond: a white-hot core inside an orange-ish rim (the colour comes from the particle), two flat values.
static func ember() -> ImageTexture:
	var image := Image.create(EMBER_PX, EMBER_PX, false, Image.FORMAT_RGBA8)
	var c := (EMBER_PX - 1) * 0.5
	for y in EMBER_PX:
		for x in EMBER_PX:
			var d := (absf(x - c) + absf(y - c)) / c
			var v := 0.0
			if d < 0.95:
				v = 0.55
			if d < 0.5:
				v = 1.0
			image.set_pixel(x, y, Color(v, v, v, 1.0 if d < 0.95 else 0.0))
	return ImageTexture.create_from_image(image)


## A painted puff: an uneven blob of noise-thresholded circles in two flat values (a lit top, a shaded underside), hard edge.
static func puff(seed_value: int = 3) -> ImageTexture:
	var image := Image.create(PUFF_PX, PUFF_PX, false, Image.FORMAT_RGBA8)
	var c := (PUFF_PX - 1) * 0.5
	for y in PUFF_PX:
		for x in PUFF_PX:
			var dx := (x - c) / c
			var dy := (y - c) / c
			var r := sqrt(dx * dx + dy * dy)
			var n := _vnoise(x * 0.09, y * 0.09, seed_value) * 0.6 + _vnoise(x * 0.21, y * 0.21, seed_value + 5) * 0.4
			var shape := r + (n - 0.5) * 0.9
			var a := 0.0
			var v := 0.0
			if shape < 0.62:
				a = 1.0
				v = 0.55
				# The lit side: up and to the left, a second flat value with its own uneven edge.
				var lit := -dy * 0.7 - dx * 0.4 + (n - 0.5) * 0.8
				if lit > 0.1:
					v = 0.95
			image.set_pixel(x, y, Color(v, v, v, a))
	return ImageTexture.create_from_image(image)


## A dust mote: a flat disc, two values.
static func mote() -> ImageTexture:
	var image := Image.create(MOTE_PX, MOTE_PX, false, Image.FORMAT_RGBA8)
	var c := (MOTE_PX - 1) * 0.5
	for y in MOTE_PX:
		for x in MOTE_PX:
			var r := sqrt((x - c) * (x - c) + (y - c) * (y - c)) / c
			var a := 1.0 if r < 0.9 else 0.0
			var v := 1.0 if r < 0.45 else 0.7
			image.set_pixel(x, y, Color(v, v, v, a))
	return ImageTexture.create_from_image(image)
